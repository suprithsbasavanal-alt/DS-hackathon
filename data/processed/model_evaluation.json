      "rmse": 10.49,
      "r2": 0.733,
      "mape": 12.94
    },
    {
      "model_name": "Direct AQI Random Forest",
      "description": "Predicts AQI directly from autoregressive AQI, criteria pollutant, and weather lags.",
      "mae": 7.74,
      "rmse": 11.14,
